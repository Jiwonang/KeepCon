{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build/web",
    "predeploy": [
      "node tool/predeploy_hosting.js"
    ],
    "ignore": [
      "**/node_modules/**",
      "**/.last_build_id"
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/invite/**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "keepcon-ab660",
          "configurations": {
            "android": "1:1084555870987:android:415fba5bceb43efd25980e",
            "web": "1:1084555870987:web:61a280ceaa34bc6c25980e"
          }
        },
        "lib/firebase_options_dev.dart": {
          "projectId": "keepcon-dev",
          "configurations": {
            "android": "1:412731641511:android:ccbd679e458b6a213ad582",
            "web": "1:412731641511:web:90038e5af07ac1a43ad582"
          }
        }
      }
    }
  }
}
