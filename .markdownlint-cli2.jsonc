// markdownlint 설정 — CodeRabbit이 이 저장소 PR에서 실제로 반복 지적한 룰만 켠다.
//
// 기본 룰셋 전체를 켜면 위반이 **924건**이다(CI가 고정한 `markdownlint-cli2@0.18.1`
// = markdownlint v0.38.0 기준. 버전마다 룰 목록이 달라 숫자가 바뀌므로 재볼 때는
// 반드시 고정 버전으로 재라 — 최신으로 재면 1,302건에 없던 룰이 끼어든다).
// 그중 4분의 3(MD013 줄 길이 674건)은 이 저장소가 **의도적으로** 위반하는 축이다 —
// 한국어 산문은 80자에서 끊기 부자연스럽고, CLAUDE.md 변경 이력 표는 한 칸에
// 문단이 들어간다. 나머지 상위도 MD032(89건)·MD022(81건) 같은 대량 빈 줄 정리라
// 이 변경의 범위 밖이다. 전부 켜면 게이트가 아니라 소음이 되고, 소음은 결국 꺼진다.
//
// 그래서 `default: false`로 두고 **CodeRabbit이 PR #47·#48·#63·#64·#84에서 8회
// 지적한 항목만** 켠다. 사람이 반복해서 같은 지적을 받던 것을 기계로 옮기는 것이
// 목적이지, 새 스타일 규범을 도입하는 것이 아니다.
{
  "config": {
    "default": false,
    // 인용문(blockquote) 사이의 빈 줄 — 인용이 두 개로 쪼개져 렌더링이 깨진다. (#47·#48·#84)
    "MD028": true,
    // 코드 펜스 앞뒤 빈 줄 — 없으면 펜스가 앞 문단에 붙어 코드로 렌더링되지 않는다.
    "MD031": true,
    // 코드 펜스 언어 식별자 — 없으면 하이라이팅이 죽는다. (#48·#64·#84)
    "MD040": true,
    // 정의되지 않은 참조 링크 — `[내용]` 표기가 참조 링크로 해석돼 깨진다. (#63)
    "MD052": true,
    // 표 앞뒤 빈 줄 — 없으면 표가 앞 문단에 붙어 표로 렌더링되지 않는다. (#64)
    "MD058": true
  },
  // **gitignore된** 파일은 검사하지 않는다.
  //
  // 이게 없으면 로컬에서 101개를 검사한다 — 추적 파일이 24개뿐인데도. 나머지
  // 77개는 `flutter build`가 만드는 `*/flutter/ephemeral/.plugin_symlinks/` 아래
  // **서드파티 플러그인 README**다(gtk·jni·app_links·firebase_auth 등). 남의
  // 저장소 파일이라 고칠 수도 없고, git은 심볼릭 링크 너머라 주소조차 잡지
  // 못한다(`git ls-files` 0건). 이들이 제외되는 근거는 중첩 `.gitignore`다 —
  // `linux/.gitignore:1:flutter/ephemeral`.
  //
  // 그래서 데스크톱 빌드를 한 번이라도 돌린 PC에서는 `tool/verify.sh`가 **항상**
  // red였다 — 진짜 실패와 구분이 안 된다. CI는 그 심볼릭 링크가 없는 깨끗한
  // 체크아웃에서 돌아 green이므로, 로컬만 거짓 경보를 내며 게이트를 소음으로
  // 만든다. 이 파일 맨 위에 적은 "전부 켜면 게이트가 아니라 소음이 되고, 소음은
  // 결국 꺼진다"가 룰이 아니라 **대상 범위** 쪽에서 재현되고 있었다.
  //
  // `gitignore: true`는 그 산출물을 대상에서 빼, 로컬이 CI와 사실상 같은 것을
  // 보게 한다(101 → 24, 위반 12 → 0).
  //
  // ⚠️ "추적 중인 파일만 검사한다"는 뜻이 **아니다.** gitignore에도 없고 아직
  // 추적도 안 되는 `.md`는 그대로 검사된다(실측: 그런 파일 하나를 두면 25개가
  // 된다). 그리고 그게 맞다 — 방금 쓴 새 문서야말로 **커밋되기 전에** 걸러야
  // 한다. tracked-only가 필요하면 `git ls-files` 결과를 린터 입력으로 넘겨야
  // 하는데, 그러면 맨손 `npx markdownlint-cli2`가 다르게 동작하고 정작 새 문서를
  // 건너뛴다. 여기서 막으려는 것은 "남의 저장소 파일"이지 "미추적"이 아니다.
  "gitignore": true,
  "globs": ["**/*.md"],
  // ⚠️ 아래 목록은 `gitignore: true`가 있어도 지울 수 없다. `.dart_tool/`·`build/`는
  // `.gitignore`에 있어 중복이지만, `node_modules`·`.claude/worktrees`는
  // **`.gitignore`에 없어서**(`git check-ignore`로 확인) 이 목록이 유일한 방어다.
  "ignores": ["node_modules/**", ".dart_tool/**", "build/**", ".claude/worktrees/**"]
}
