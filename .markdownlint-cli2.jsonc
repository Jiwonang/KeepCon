// markdownlint 설정 — CodeRabbit이 이 저장소 PR에서 실제로 반복 지적한 룰만 켠다.
//
// 기본 룰셋 전체를 켜면 위반이 **924건**이다(CI가 고정한 `markdownlint-cli2@0.18.1`
// = markdownlint v0.38.0 기준. 버전마다 룰 목록이 달라 숫자가 바뀌므로 재볼 때는
// 반드시 고정 버전으로 재라 — 최신으로 재면 1,302건에 없던 룰이 끼어든다).
// 그중 4분의 3(MD013 줄 길이 674건)은 이 저장소가 **의도적으로** 위반하는 축이다 —
// 한국어 산문은 80자에서 끊기 부자연스럽고, CLAUDE.md 변경 이력 표는 한 칸에
// 문단이 들어간다. 나머지 상위도 MD032(89건)·MD022(81건) 같은 대량 빈 줄 정리라
// 이 변경의 범위 밖이다. 전부 켜면 게이트가 아니라 소음이 되고, 소음은 결국 꺼진다.
//
// 그래서 `default: false`로 두고 **CodeRabbit이 PR #47·#48·#63·#64·#84에서 8회
// 지적한 항목만** 켠다. 사람이 반복해서 같은 지적을 받던 것을 기계로 옮기는 것이
// 목적이지, 새 스타일 규범을 도입하는 것이 아니다.
{
  "config": {
    "default": false,
    // 인용문(blockquote) 사이의 빈 줄 — 인용이 두 개로 쪼개져 렌더링이 깨진다. (#47·#48·#84)
    "MD028": true,
    // 코드 펜스 앞뒤 빈 줄 — 없으면 펜스가 앞 문단에 붙어 코드로 렌더링되지 않는다.
    "MD031": true,
    // 코드 펜스 언어 식별자 — 없으면 하이라이팅이 죽는다. (#48·#64·#84)
    "MD040": true,
    // 정의되지 않은 참조 링크 — `[내용]` 표기가 참조 링크로 해석돼 깨진다. (#63)
    "MD052": true,
    // 표 앞뒤 빈 줄 — 없으면 표가 앞 문단에 붙어 표로 렌더링되지 않는다. (#64)
    "MD058": true
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", ".dart_tool/**", "build/**", ".claude/worktrees/**"]
}
