rules_version = '2';

// KeepCon Firestore 보안 규칙.
//
// 접근 원칙:
// - users: 본인 프로필만.
// - gifticons: 소유자(ownerId)만.
// - groups: 멤버만 읽기·변경 / 방장만 삭제. 비멤버가 스스로 합류하는 경로는 없다
//   (합류는 방장 승인을 거친다 — 아래 groups 규칙 주석 참조).
// - sharedGifticons·usageLogs·notifications: 소속 그룹 멤버만.
// - inviteTokens: 토큰 → 그룹 조회. **get만** 열고 list는 막는다 / 쓰기는 방장만.
// - joinRequests: 요청자 본인과 그 그룹의 방장만. 생성은 비멤버가 만료 전에만.
// - shareLocks: 내부 잠금 메커니즘(민감 데이터 없음) — 로그인 사용자면 관리.
// - 그 외: 기본 차단.
//
// ⚠️ 방어 수준(defense-in-depth): 세밀한 행위 가드(방장만 소유권 이전, 공유자만 취소,
//    상태 전이 등)는 앱의 트랜잭션 로직이 담당하고, 이 규칙은 **멤버십/소유권 수준**의
//    접근 통제를 제공한다. 규칙만으로 모든 트랜잭션 가드를 복제하지는 않는다.
//
// 배포: `firebase deploy --only firestore:rules,firestore:indexes`
//   (또는 콘솔 > Firestore > 규칙 탭).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // 그룹 방장 판정 — inviteTokens·joinRequests가 그룹 소유권을 물을 때 쓴다.
    function isGroupOwner(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == uid();
    }

    // 참여 요청 문서의 하한·타입. 승인 시 displayName·avatarEmoji가 그룹 문서로
    // 옮겨 가므로 길이도 제한한다(멤버 목록에 긴 문자열이 박히는 것을 막는다).
    function isWellFormedJoinRequest(d) {
      return d.keys().hasAll(
               ['groupId', 'userId', 'displayName', 'avatarEmoji',
                'requestedAt', 'status'])
        && d.groupId is string
        && d.userId is string
        && d.displayName is string && d.displayName.size() <= 60
        && d.avatarEmoji is string && d.avatarEmoji.size() <= 8
        && d.requestedAt is timestamp
        // 요청 시각은 대기 목록의 **정렬 기준**이다. 클라이언트가 정하는 값이라
        // 과거로 적으면 남보다 앞줄에 설 수 있다. 서버 시각 근처로 좁혀 소급을 막는다
        // (정확히 `request.time`을 요구하면 클라이언트가 값을 되읽어야 해서, 반환값이
        //  실제 저장값과 어긋나지 않는 선에서 창을 둔다).
        && d.requestedAt <= request.time
        && d.requestedAt > request.time - duration.value(10, 'm');
    }

    // 참여를 **요청**할 자격 — 아직 멤버가 아니고 초대가 살아 있을 때.
    // 같은 그룹 문서를 두 번 묻지 않도록 한 함수에서 한 번만 읽는다.
    function canRequestJoin(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && !(uid() in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds)
        && request.time < get(/databases/$(database)/documents/groups/$(groupId)).data.inviteExpiresAt;
    }

    // 그룹 멤버십 판정 — 상위 group 문서의 memberIds를 참조(문서 존재 확인 포함).
    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && uid() in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // 사용자 프로필 — 본인만. 단 `plan`(구독 플랜) 필드는 클라이언트가 쓸 수 없다:
    // 본인 write를 전면 허용하면 사용자가 자기 문서에 plan: "premium"을 넣어
    // 스스로 유료 승격할 수 있다. 결제 검증 경로(서버/스토어 영수증)가 붙기
    // 전까지 plan은 읽기 전용이다. 필드 단위로 막는 이유: 전면 차단하면
    // displayName 수정(프로필 편집) 같은 기존 기능이 함께 깨진다.
    match /users/{userId} {
      allow read: if isSignedIn() && uid() == userId;
      allow create: if isSignedIn() && uid() == userId
        && !request.resource.data.keys().hasAny(['plan']);
      allow update: if isSignedIn() && uid() == userId
        && !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['plan']);
      allow delete: if isSignedIn() && uid() == userId;
    }


    // 개인 기프티콘 — 소유자만.
    match /gifticons/{id} {
      allow read, update, delete:
        if isSignedIn() && resource.data.ownerId == uid();
      allow create:
        if isSignedIn() && request.resource.data.ownerId == uid();
    }

    // 그룹.
    match /groups/{groupId} {
      allow read: if isSignedIn() && uid() in resource.data.memberIds;

      // 생성: 만드는 사람이 방장(ownerId==본인)이고 멤버에 포함돼야 한다.
      allow create: if isSignedIn()
        && request.resource.data.ownerId == uid()
        && uid() in request.resource.data.memberIds;

      // 삭제: 방장만.
      allow delete: if isSignedIn() && resource.data.ownerId == uid();

      // 방장의 운영 변경 — 이름·초대·정원·멤버 구성 전반.
      //
      // 변경 후에도 ownerId가 멤버 목록 안에 있어야 한다. 이 한 줄이 "방장 없는 그룹"을
      // 막고, 동시에 소유권 이전을 자연스럽게 표현한다 — 방장이 그냥 나가면 ownerId가
      // 멤버 밖으로 나가 거부되고, 새 방장을 지정하며 나가면 통과한다.
      function isGroupOwnerUpdate() {
        return resource.data.ownerId == uid()
          && request.resource.data.ownerId in request.resource.data.memberIds;
      }

      // 일반 멤버에게 허용되는 유일한 변경 — **memberIds에서 자기 하나만 빼는 '나가기'**.
      //
      // `members`(맵 배열)는 **건드리지 못하게 한다.** 규칙은 배열을 순회할 수 없어
      // "지워진 원소가 정말 나 자신인가"를 확인할 방법이 없다. 두 배열을 함께 열어 주면
      // 크기·포함 관계 검사를 모두 통과하면서 memberIds에서는 자기를, members에서는
      // **남을** 지우는 조합이 성립한다(두 필드가 갈라져, 지워진 멤버는 화면에서 사라지지만
      // memberIds 기반인 보안 규칙·쿼리에서는 살아 있는 유령이 된다).
      //
      // 그래서 멤버십의 정본을 memberIds 하나로 못박는다 — 이미 쿼리(array-contains)와
      // isGroupMember()가 보는 필드다. `members`는 표시용 메타데이터이고, 떠난 사람의
      // 항목은 읽는 쪽(_groupFromDocOrNull)에서 걸러지며 다음 방장 쓰기에서 정리된다.
      function isSelfLeave() {
        let before = resource.data;
        let after = request.resource.data;
        // 방장은 이 경로를 쓸 수 없다. 쓸 수 있게 두면 방장이 혼자 빠져나가 ownerId가
        // 멤버 밖을 가리키는 '주인 없는 그룹'이 남는다(앱은 그런 문서를 손상으로 보고
        // 목록에서 통째로 걸러내므로, 남은 멤버에게는 그룹이 사라진 것처럼 보인다).
        // 방장의 이탈 경로는 둘뿐이다 — 혼자면 그룹 삭제, 아니면 소유권 이전.
        return before.ownerId != uid()
          && after.diff(before).affectedKeys().hasOnly(['memberIds'])
          && !(uid() in after.memberIds)
          && before.memberIds.hasAll(after.memberIds)
          && after.memberIds.size() == before.memberIds.size() - 1;
      }

      // 변경: **멤버만**. 방장은 그룹 운영 전반, 일반 멤버는 나가기 한 가지뿐이다.
      //
      // ⚠️ 예전에는 여기에 "비멤버가 자신을 추가하는 합류" 예외가 있었다. 그 조항은
      //    초대코드·만료·정원·inviteOwnerOnly를 **하나도 검사하지 않았다**(전부 클라이언트
      //    트랜잭션 안에만 있는 가드라, 규칙을 거치지 않는 요청에는 무력했다). 결국
      //    groupId만 알면 초대 없이, 심지어 자기 role을 owner로 써넣고 합류할 수 있었다.
      //    합류는 '방장 승인'을 거치도록 바꿀 예정이므로(참여 요청 → 승인) 이 예외는 삭제한다.
      //
      //    승인 흐름은 아래 `inviteTokens`·`joinRequests`에 있다. 비멤버가 그룹에 들어오는
      //    유일한 경로는 **방장의 승인 쓰기**(isGroupOwnerUpdate)이며, 요청자 본인은 groups
      //    문서에 손댈 수 없다.
      //
      //    옛 경로 `ShareRepository.joinGroup(inviteToken)`은 비멤버가 inviteToken으로
      //    groups를 조회하는 것부터 위 `allow read`(멤버만)에 막혀 여전히 동작하지 않는다 —
      //    우회로가 아니다. 화면에서 걷어낼 때 구현도 함께 지운다.
      allow update: if isSignedIn()
        && uid() in resource.data.memberIds
        && (isGroupOwnerUpdate() || isSelfLeave());
    }

    // 공유 기프티콘 — 소속 그룹 멤버.
    match /sharedGifticons/{id} {
      allow read, update, delete:
        if isSignedIn() && isGroupMember(resource.data.groupId);
      allow create:
        if isSignedIn() && isGroupMember(request.resource.data.groupId);
    }

    // 사용 이력 — 멤버 읽기/생성, 불변(수정·삭제 금지).
    match /usageLogs/{id} {
      allow read: if isSignedIn() && isGroupMember(resource.data.groupId);
      allow create: if isSignedIn() && isGroupMember(request.resource.data.groupId);
      allow update, delete: if false;
    }

    // 그룹 알림 — 멤버 읽기/생성, 불변.
    match /notifications/{id} {
      allow read: if isSignedIn() && isGroupMember(resource.data.groupId);
      allow create: if isSignedIn() && isGroupMember(request.resource.data.groupId);
      allow update, delete: if false;
    }

    // 공유 잠금(내부 메커니즘) — 민감 데이터 없음. 그룹 삭제 후 정리(cascade)도
    // 허용해야 하므로 로그인 사용자 수준으로 둔다.
    match /shareLocks/{gifticonId} {
      allow read, write: if isSignedIn();
    }

    // 알림 읽음 상태(마지막 읽음 시각) — 본인 것만 읽기/쓰기.
    match /notificationReads/{userId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    // 초대 토큰 → 그룹 조회. 문서 id가 곧 토큰이다.
    //
    // 비멤버는 `groups`를 읽을 수 없으므로(위 read 규칙) 토큰만으로 그룹을 찾을 길이
    // 없다. 이 문서가 그 다리인데, 다리를 놓으면서 대문을 열어 주면 안 되므로 담는 것은
    // `groupId`와 만료 시각뿐이다 — 그룹명·이모지·인원은 승인 전 요청자에게 보여주지
    // 않는 정책이라 아예 저장하지 않는다.
    match /inviteTokens/{token} {
      // **`get`만 열고 `list`는 막는다.** 목록을 열면 토큰을 모르는 사람이 전부 훑어
      // 모든 그룹의 id를 얻는다 — 토큰을 추측 불가능하게 만드는 의미가 사라진다.
      allow get: if isSignedIn();
      allow list: if false;

      // 발급·재발급·정리는 그 그룹의 방장만. 필드를 둘로 못박아 다른 값이 딸려 오는 것도 막는다.
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'expiresAt'])
        && request.resource.data.groupId is string
        && request.resource.data.expiresAt is timestamp
        // 만료의 **정본은 그룹 문서**다. 두 곳에 복제되는 값이라 어긋나면 클라이언트와
        // 규칙의 판정이 갈린다 — 유효한 링크가 거부되거나 그 반대가 된다. 쓰기 시점에
        // 같은 값만 허용해 복제본이 정본을 따르게 못박는다.
        && request.resource.data.expiresAt ==
             get(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
               .data.inviteExpiresAt
        && isGroupOwner(request.resource.data.groupId)
        // 이미 있는 문서를 다른 그룹으로 돌려쓰지 못하게 한다(토큰 탈취 방지).
        && (!exists(/databases/$(database)/documents/inviteTokens/$(token))
            || resource.data.groupId == request.resource.data.groupId);
      // 없는 문서의 삭제는 **no-op이어야 한다.** `resource`가 null인데 `resource.data`를
      // 만지면 규칙 평가가 오류로 죽고, 오류는 곧 거부다. 레거시 그룹에는 이 문서가
      // 없으므로 그대로 두면 그룹 삭제·나가기·재발급이 통째로 막힌다(기존 데이터 전부).
      // 존재 여부가 새지 않는가? `allow get`이 이미 로그인 사용자에게 열려 있어 새 정보가
      // 아니다 — joinRequests 쪽은 그렇지 않으므로 거기엔 이 예외를 두지 않는다.
      allow delete: if isSignedIn()
        && (resource == null || isGroupOwner(resource.data.groupId));
    }

    // 참여 요청 — 초대 링크를 받은 **비멤버**가 방장의 승인을 기다리는 문서.
    //
    // 문서 id는 `{groupId}_{userId}`로 고정한다. (그룹, 사용자)당 요청 하나라는 계약을
    // 저장소가 강제하게 하려는 것이다 — 같은 링크를 두 번 눌러도 방장 화면에 요청이
    // 쌓이지 않는다.
    match /joinRequests/{requestId} {
      // 읽기: **요청자 본인 또는 그 그룹의 방장만.** 대기자 명단은 아직 멤버가 아닌
      // 사람들의 이름이라 일반 멤버에게도 열지 않는다.
      allow read: if isSignedIn() && (
        resource.data.userId == uid() || isGroupOwner(resource.data.groupId)
      );

      // 생성: 본인 요청만, 대기 상태로만. 문서 id가 규약과 맞아야 하고, 이미 멤버가
      // 아니어야 하며, 초대가 만료되지 않았어야 한다.
      //
      // 만료·멤버십을 **규칙에서도** 보는 이유: 클라이언트 트랜잭션 안에만 두면 규칙을
      // 거치지 않는 요청에 무력하다(PR #89에서 정확히 그 구멍으로 비멤버가 방장으로
      // 합류할 수 있었다). 정원은 여기서 보지 않는다 — 대기자는 자리를 차지하지 않고,
      // 정원 검사는 승인 시점의 그룹 쓰기가 맡는다(계약과 동일).
      allow create: if isSignedIn()
        && request.resource.data.userId == uid()
        && requestId == request.resource.data.groupId + '_' + uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(
             ['groupId', 'userId', 'displayName', 'avatarEmoji',
              'requestedAt', 'status'])
        // `hasOnly`는 **상한만** 정한다. 빠뜨린 필드는 읽기 매퍼의 폴백(`''`)이 되고,
        // 승인 시 그 값이 그대로 그룹 문서의 멤버 이름으로 굳는다 — 표시 문제가 아니라
        // 멤버 전원이 보는 문서에 박히는 데이터다. 하한과 타입도 함께 못박는다.
        && isWellFormedJoinRequest(request.resource.data)
        && canRequestJoin(request.resource.data.groupId);

      // 변경은 둘뿐이다 — 요청자의 재요청, 방장의 결정.
      allow update: if isSignedIn() && (
        // ① 요청자가 결정 끝난 요청을 다시 대기로 되돌린다(거절 뒤 재요청, 강퇴 뒤 재요청).
        //    표시 스냅샷도 함께 새로 찍으므로 그 세 필드까지 허용한다.
        (
          resource.data.userId == uid()
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'displayName', 'avatarEmoji', 'requestedAt'])
          // 재요청도 표시 스냅샷을 다시 쓰므로 같은 타입 검사를 건다 — 없으면 거절 뒤
          // 재요청으로 같은 값을 우회 주입할 수 있다.
          && isWellFormedJoinRequest(request.resource.data)
          && canRequestJoin(resource.data.groupId)
        )
        // ② 방장이 대기 중인 요청을 승인하거나 거절한다. **status 한 필드만** 바뀐다.
        || (
          isGroupOwner(resource.data.groupId)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status'])
          && request.resource.data.status in ['approved', 'rejected']
        )
      );

      // 삭제: 요청자의 취소, 또는 그룹이 사라질 때 방장의 정리.
      allow delete: if isSignedIn() && (
        resource.data.userId == uid() || isGroupOwner(resource.data.groupId)
      );
    }

    // 그 외 모든 문서 기본 차단.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
