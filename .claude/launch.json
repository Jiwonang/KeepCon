{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "keepcon-web",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--directory",
        "build/web"
      ],
      "port": 8090
    },
    {
      "name": "keepcon-web-debug",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-hostname",
        "localhost",
        "--web-port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "keepcon-emulator",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-hostname",
        "localhost",
        "--web-port",
        "8082",
        "--dart-define=USE_FIREBASE_EMULATOR=true"
      ],
      "port": 8082
    }
  ]
}
