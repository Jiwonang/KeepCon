{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "keepcon-web",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080",
        "--directory",
        "build/web"
      ],
      "port": 8080
    },
    {
      "name": "keepcon-web-debug",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-hostname",
        "localhost",
        "--web-port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
